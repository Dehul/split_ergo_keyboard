#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ----------------------------------------------------------------------------------------------------------
            // | ESC  |  1  |  2  |  3  |  4  |  5  |  -  |                 |  =  |  Y  |  U   |  I  |  O  |  P  | VLUP |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |  {  |                 |  }  |  Y  |  U   |  I  |  O  |  P  | VODN |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  *  |                 |  "  |  H  |  J   |  K  |  L  |  /  |  \   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |  *  | LUP |    | LDN  |  ;  |  N  |  M   |  ,  |  .  |  UP | SHFT |
            // |   *  |  *  |  *  |  *  | COM |  *  | SPC | DEL |    | BSPC | SPC |  *  | COM  | PLY | LFT | DWN | RGT  |

            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3  &kp N4        &kp N5  &kp CARET                     &kp EQUAL      &kp N6  &kp N7         &kp N8            &kp N9          &kp N0          &kp C_VOLUME_UP
&kp TAB         &kp Q   &kp W   &kp E   &kp R         &kp T   &kp LBRC                      &kp RBRC       &kp Y   &kp U          &kp I             &kp O           &kp P           &kp C_VOLUME_DOWN
&kp CAPS        &kp A   &kp S   &kp D   &kp F         &kp G   &kp                           &kp DQT        &kp H   &kp J          &kp K             &kp L           &kp FSLH        &kp BSLH
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C   &kp V         &kp B   &kp        &kp LDN  &kp LUP   &kp SEMICOLON  &kp N   &kp M          &kp COMMA         &kp DOT         &kp UP_ARROW    &kp LSHFT
&kp LSHFT       &kp     &kp     &kp     &kp LEFT_GUI  &mo     &kp SPACE  &kp DEL  &kp BSPC  &kp SPACE      &mo     &kp RIGHT_GUI  &kp C_PLAY_PAUSE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        lower_layer {
            // ----------------------------------------------------------------------------------------------------------
            // | ESC  |  1  |  2  |  3  |  4  |  5  |  -  |                 |  =  |  Y  |  U   |  I  |  O  |  P  | VLUP |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |  {  |                 |  }  |  Y  |  U   |  I  |  O  |  P  | VODN |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  *  |                 |  "  |  H  |  J   |  K  |  L  |  /  |  \   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |  *  | LUP |    | LDN  |  ;  |  N  |  M   |  ,  |  .  |  UP | SHFT |
            // |   *  |  *  |  *  |  *  | COM |  *  | SPC | DEL |    | BSPC | SPC |  *  | COM  | PLY | LFT | DWN | RGT  |

            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3  &kp N4        &kp N5  &kp CARET                     &kp EQUAL      &kp N6  &kp N7         &kp N8            &kp N9          &kp N0          &kp C_BRIGHTNESS_INC
&kp TAB         &kp Q   &kp W   &kp E   &kp R         &kp T   &kp LBRC                      &kp RBRC       &kp Y   &kp U          &kp I             &kp O           &kp P           &kp C_BRIGHTNESS_DEC
&kp CAPS        &kp A   &kp S   &kp D   &kp F         &kp G   &kp                           &kp DQT        &kp H   &kp J          &kp K             &kp L           &kp FSLH        &kp BSLH
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C   &kp V         &kp B   &kp        &kp LDN  &kp LUP   &kp SEMICOLON  &kp N   &kp M          &kp COMMA         &kp DOT         &kp UP_ARROW    &kp LSHFT
&kp LSHFT       &kp     &kp     &kp     &kp LEFT_GUI  &kmo    &kp SPACE  &kp DEL  &kp BSPC  &kp SPACE      &mo     &kp RIGHT_GUI  &kp C_PLAY_PAUSE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        raise_layer {
            // ----------------------------------------------------------------------------------------------------------
            // | ESC  |  1  |  2  |  3  |  4  |  5  |  -  |                 |  =  |  Y  |  U   |  I  |  O  |  P  | VLUP |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |  {  |                 |  }  |  Y  |  U   |  I  |  O  |  P  | VODN |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  *  |                 |  "  |  H  |  J   |  K  |  L  |  /  |  \   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |  *  | LUP |    | LDN  |  ;  |  N  |  M   |  ,  |  .  |  UP | SHFT |
            // |   *  |  *  |  *  |  *  | COM |  *  | SPC | DEL |    | BSPC | SPC |  *  | COM  | PLY | LFT | DWN | RGT  |

            bindings = <
&kp ESC         &kp F1  &kp F2  &kp F3  &kp F4        &kp F5  &kp CARET                     &kp EQUAL      &kp F6  &kp F7         &kp F8            &kp F9          &kp N0          &kp C_VOLUME_UP
&kp TAB         &kp Q   &kp W   &kp E   &kp R         &kp T   &kp LBRC                      &kp RBRC       &kp Y   &kp U          &kp I             &kp O           &kp P           &kp C_VOLUME_DOWN
&kp CAPS        &kp A   &kp S   &kp D   &kp F         &kp G   &kp                           &kp DQT        &kp H   &kp J          &kp K             &kp L           &kp FSLH        &kp BSLH
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C   &kp V         &kp B   &kp        &kp LDN  &kp LUP   &kp SEMICOLON  &kp N   &kp M          &kp COMMA         &kp DOT         &kp UP_ARROW    &kp LSHFT
&kp LSHFT       &kp     &kp     &kp     &kp LEFT_GUI  &mo     &kp SPACE  &kp DEL  &kp BSPC  &kp SPACE      &mo     &kp RIGHT_GUI  &kp C_PLAY_PAUSE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };
    };
};
