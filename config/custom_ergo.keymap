#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // | ESC  |  1  |  2  |  3  |  4  |  5  |  -  |                 |  =  |  Y  |  U   |  I  |  O  |  P  | VLUP |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |  {  |                 |  }  |  Y  |  U   |  I  |  O  |  P  | VODN |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  *  |                 |  "  |  H  |  J   |  K  |  L  |  /  |  \   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |  *  | LUP |    | LDN  |  ;  |  N  |  M   |  ,  |  .  |  UP | SHFT |
            // |   *  |  *  |  *  |  *  | COM |  *  | SPC | DEL |    | BSPC | SPC |  *  | COM  | PLY | LFT | DWN | RGT  |

            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3  &kp N4        &kp N5  &kp CARET                     &kp EQUAL      &kp N6  &kp N7         &kp N8            &kp N9          &kp N0          &kp C_VOLUME_UP
&kp TAB         &kp Q   &kp W   &kp E   &kp R         &kp T   &kp LBRC                      &kp RBRC       &kp Y   &kp U          &kp I             &kp O           &kp P           &kp C_VOLUME_DOWN
&kp CAPS        &kp A   &kp S   &kp D   &kp F         &kp G   &kp                           &kp DQT        &kp H   &kp J          &kp K             &kp L           &kp FSLH        &kp BSLH
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C   &kp V         &kp B   &kp        &kp LDN  &kp LUP   &kp SEMICOLON  &kp N   &kp M          &kp COMMA         &kp DOT         &kp UP_ARROW    &kp LSHFT
&kp LSHFT       &kp     &kp     &mo     &kp LEFT_GUI  &kp     &kp SPACE  &kp DEL  &kp BSPC  &kp SPACE      &mo     &kp RIGHT_GUI  &kp C_PLAY_PAUSE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB       &kp N1        &kp N2        &kp N3        &kp N4    &kp N5    &kp N6      &kp N7     &kp N8    &kp N9  &kp N0     &kp BSPC  &bt BT_CLR  &bt BT_SEL 0
&bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp LEFT  &kp DOWN  &kp UP      &kp RIGHT  &trans    &trans  &kp LSHFT  &trans    &trans      &trans
&trans        &trans        &trans        &trans        &trans    &trans    &trans      &trans     &kp LGUI  &trans  &kp SPACE  &kp RET   &trans      &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB  &kp EXCL  &kp AT     &kp HASH  &kp DLLR   &kp PRCNT  &kp CARET      &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp BSPC  &kp LCTRL  &trans
&trans   &trans    &trans     &trans    &kp MINUS  &kp EQUAL  &kp LBKT       &kp RBKT   &kp BSLH   &kp GRAVE  &kp LSHFT  &trans    &trans     &trans
&trans   &trans    &kp UNDER  &kp PLUS  &kp LBRC   &kp RBRC   &kp PIPE       &kp TILDE  &kp LGUI   &trans     &kp SPACE  &kp RET   &trans     &kp RALT
            >;
        };
    };
};
